{
  "manifest_version": 3,
  "name": "Banana Flow Bridge",
  "version": "0.1.0",
  "description": "Local bridge between Banana Node and Google Flow.",
  "permissions": ["storage", "alarms", "tabs", "webRequest", "scripting"],
  "host_permissions": [
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://labs.google/*"]
    }
  ],
  "action": {
    "default_title": "Banana Flow Bridge"
  }
}

